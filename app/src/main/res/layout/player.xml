<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#10111A"
    android:fitsSystemWindows="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="0dp">

    <!-- TOP BAR -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageButton
            android:id="@+id/btnFullPlayerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="13dp"
            android:src="@drawable/ic_back"
            app:tint="#D9D9E4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/playerTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now Playing"
            android:textColor="#E8E8F0"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/playerMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="13dp"
            android:src="@drawable/menu_vertical"
            app:tint="#D9D9E4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- CONTENT -->

    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- LYRICS + ALBUM ART AREA -->

        <FrameLayout
            android:id="@+id/playerVisualContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- SYNCHRONIZED LYRICS -->

            <LinearLayout
                android:id="@+id/lyricsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lyricsPrevious"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Previous lyric"
                    android:textColor="#55586B"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:alpha="0.65" />

                <TextView
                    android:id="@+id/lyricsCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:maxLines="4"
                    android:text="Synchronized Lyrics"
                    android:textColor="#F1F1F6"
                    android:textSize="25sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/lyricsNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Next lyric"
                    android:textColor="#55586B"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:alpha="0.65" />

            </LinearLayout>


            <!-- ALBUM ART -->

            <androidx.cardview.widget.CardView
                android:id="@+id/fullPlayerAlbumCard"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:elevation="8dp"
                app:cardBackgroundColor="#1A1B27"
                app:cardCornerRadius="26dp">

                <ImageView
                    android:id="@+id/fullPlayerAlbumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_play"
                    android:contentDescription="Album art" />

            </androidx.cardview.widget.CardView>

        </FrameLayout>


        <!-- SONG INFORMATION -->

        <LinearLayout
            android:id="@+id/songInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fullPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:text="No song"
                android:textColor="#F1F1F6"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/fullPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:text="Unknown artist"
                android:textColor="#9294A7"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- SEEK BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fullPlayerElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0:00"
                android:textColor="#9294A7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <com.urfavxbf.kanade.ui.player.EqualizerSeekBar
                android:id="@+id/seekFullPlayer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:max="1000"
                android:progress="0"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/fullPlayerDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="0:00"
                android:textColor="#9294A7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fullPlayerControls"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/btnFullPrevious"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="15dp"
                android:src="@drawable/ic_previous"
                app:tint="#ffffff"
                app:layout_constraintEnd_toStartOf="@id/btnFullPlayPause"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btnFullPlayPause"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:background="@android:color/transparent"
                android:contentDescription="Play or pause"
                android:padding="8dp"
                android:src="@drawable/ic_play"
                app:tint="#ffffff"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btnFullNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="15dp"
                android:src="@drawable/ic_next"
                app:tint="#ffffff"
                app:layout_constraintStart_toEndOf="@id/btnFullPlayPause"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerExtraControls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp">

            <ImageButton
                android:id="@+id/btnEqualizer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_equalizer"
                android:tint="#A8ABB9"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Equalizer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:id="@+id/playerRightControls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnShuffle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_shuffle"
                    android:tint="#A8ABB9"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Shuffle" />

                <ImageButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_repeat"
                    android:tint="#A8ABB9"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Repeat" />

                <ImageButton
                    android:id="@+id/btnQueue"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_queue_music"
                    android:tint="#A8ABB9"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Queue" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</LinearLayout>
