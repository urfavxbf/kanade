<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomPart"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ================================================= -->
    <!-- GLOBAL MINI PLAYER -->
    <!-- ================================================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/miniPlayerRoot"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#181818"
        app:cardCornerRadius="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/miniAlbumArt"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Album art" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No song playing"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Unknown artist"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/miniPrevious"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_previous"
                android:tint="#FFFFFF"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/miniPlayPause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFF"
                android:contentDescription="Play or pause" />

            <ImageButton
                android:id="@+id/miniNext"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFF"
                android:contentDescription="Next" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <!-- ================================================= -->
    <!-- GLOBAL BOTTOM NAVBAR -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/kanadeNavCard"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:cardBackgroundColor="#181818"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- SONGS -->

            <LinearLayout
                android:id="@+id/navSongs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navSongsIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_tracks_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Songs" />

                <TextView
                    android:id="@+id/navSongsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Songs"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- ARTISTS -->

            <LinearLayout
                android:id="@+id/navArtist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navArtistIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_artist_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Artists" />

                <TextView
                    android:id="@+id/navArtistText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Artists"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navDashboardIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/house_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Dashboard" />

                <TextView
                    android:id="@+id/navDashboardText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- PLAYLIST -->

            <LinearLayout
                android:id="@+id/navPlaylist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navPlaylistIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/list_music_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Playlists" />

                <TextView
                    android:id="@+id/navPlaylistText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Playlists"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- YOUTUBE -->

            <LinearLayout
                android:id="@+id/navYouTube"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navYouTubeIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_youtube"
                    android:scaleType="centerInside"
                    android:contentDescription="YouTube" />

                <TextView
                    android:id="@+id/navYouTubeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="YouTube"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
