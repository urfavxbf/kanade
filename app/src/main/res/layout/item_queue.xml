<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:background="@drawable/queue_item_background">

    <ImageView
        android:id="@+id/queueAlbumArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Album art"
        android:scaleType="centerCrop"
        android:src="@drawable/album_art" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/queueSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Song title"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/queueSongArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/queueCurrentIndicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="Currently playing"
        android:padding="4dp"
        android:src="@drawable/ic_queue_playing"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/queueDragHandle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:contentDescription="Drag to reorder"
        android:padding="10dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="#777A89" />
</LinearLayout>
