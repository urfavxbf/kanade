<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queueSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="20dp"
    android:background="#10111A">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/queue_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtQueueTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Queue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#C9C4FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drag songs to reorder"
                android:textSize="12sp"
                android:textColor="#888995"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQueueShuffle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_shuffle"
            android:contentDescription="Shuffle"
            android:padding="11dp" />

        <ImageButton
            android:id="@+id/btnQueueClear"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_clear"
            android:contentDescription="Clear queue"
            android:padding="11dp" />

        <ImageButton
            android:id="@+id/btnQueueSave"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_playlist_add"
            android:contentDescription="Save as playlist"
            android:padding="11dp" />

        <ImageButton
            android:id="@+id/btnQueueClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            android:padding="11dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="#20FFFFFF" />

    <TextView
        android:id="@+id/txtQueueEmpty"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:text="Queue is empty"
        android:textSize="15sp"
        android:textColor="#888995"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerQueue"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

</LinearLayout>