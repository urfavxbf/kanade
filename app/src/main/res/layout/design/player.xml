<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    tools:context=".ui.player.PlayerFragment">

    <!-- =========================
         TOP BAR
         ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerTopBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnFullPlayerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/playerTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW PLAYING"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/playerMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         ARTWORK STAGE
         ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerArtworkStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/playerTopBar"
        app:layout_constraintBottom_toTopOf="@id/playerInfoBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fullPlayerAlbumCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#262626"
            app:strokeWidth="1dp"
            app:layout_constraintWidth_percent="0.82"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/fullPlayerAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album art"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_media_play"/>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         SONG INFO
         ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerInfoBlock"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/playerActionRow">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPlayerFavorite"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/fullPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="No song"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/fullPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Unknown artist"
                android:textColor="#969696"
                android:textSize="14sp"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPlayerFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite"
            android:padding="11dp"
            android:src="@drawable/heart_blank"
            android:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         ACTION ROW
         ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerActionRow"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toTopOf="@id/playerProgressBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPlayerLyrics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lyrics"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#818181"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btnPlayerQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Queue"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#818181"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         PROGRESS / TIME
         ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerProgressBlock"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toTopOf="@id/fullPlayerControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <SeekBar
            android:id="@+id/seekFullPlayer"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:max="1000"
            android:progress="0"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#8B8B8B"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/txtRemainingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-0:00"
            android:textColor="#8B8B8B"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         TRANSPORT CONTROLS
         ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fullPlayerControls"
        android:layout_width="0dp"
        android:layout_height="84dp"
        app:layout_constraintBottom_toTopOf="@id/playerBottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shuffle"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#777777"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btnFullPrevious"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            android:padding="14dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/btnShuffle"
            app:layout_constraintEnd_toStartOf="@id/fullPlayerPlayContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fullPlayerPlayContainer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="36dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toEndOf="@id/btnFullPrevious"
            app:layout_constraintEnd_toStartOf="@id/btnFullNext"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnFullPlayPause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="Play or pause"
                android:padding="20dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#101010"/>

        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/btnFullNext"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            android:padding="14dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/fullPlayerPlayContainer"
            app:layout_constraintEnd_toStartOf="@id/btnRepeat"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repeat"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#777777"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         BOTTOM PLAYER ACTIONS
         ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerBottomActions"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:cardBackgroundColor="#171717"
        app:cardCornerRadius="25dp"
        app:cardElevation="0dp"
        app:strokeColor="#282828"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnPlayerShare"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share"
                android:padding="14dp"
                android:src="@android:drawable/ic_menu_share"
                android:tint="#858585"/>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#2A2A2A"/>

            <ImageButton
                android:id="@+id/btnOpenQueue"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open queue"
                android:padding="14dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#858585"/>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#2A2A2A"/>

            <ImageButton
                android:id="@+id/btnPlayerSleepTimer"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sleep timer"
                android:padding="14dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                android:tint="#858585"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>