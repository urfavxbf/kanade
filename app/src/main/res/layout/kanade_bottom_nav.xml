<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kanadeBottomNav"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/kanadeNavCard"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#181818">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- SONGS -->

            <LinearLayout
                android:id="@+id/navSongs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navSongsIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_tracks_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Songs" />

                <TextView
                    android:id="@+id/navSongsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Songs"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ARTISTS -->

            <LinearLayout
                android:id="@+id/navArtist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navArtistIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_artist_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Artists" />

                <TextView
                    android:id="@+id/navArtistText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Artists"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navDashboardIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/house_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Dashboard" />

                <TextView
                    android:id="@+id/navDashboardText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- PLAYLIST -->

            <LinearLayout
                android:id="@+id/navPlaylist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navPlaylistIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/list_music_blank"
                    android:scaleType="centerInside"
                    android:contentDescription="Playlists" />

                <TextView
                    android:id="@+id/navPlaylistText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Playlists"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- YOUTUBE -->

            <LinearLayout
                android:id="@+id/navYouTube"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navYouTubeIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_youtube"
                    android:scaleType="centerInside"
                    android:contentDescription="YouTube" />

                <TextView
                    android:id="@+id/navYouTubeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="YouTube"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>